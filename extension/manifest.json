{
  "manifest_version": 3,
  "name": "ChatGPT Voice Player",
  "version": "1.1.0",
  "description": "A real audio player under every ChatGPT reply: Read Aloud with pause, seek and speed.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "ChatGPT Voice Player",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"],
      "css": ["player.css"],
      "run_at": "document_idle"
    }
  ]
}
